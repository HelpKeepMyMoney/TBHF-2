rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: user is admin (has a document in admins collection with id = their uid)
    function isAdmin() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Newsletter: create/update via API (Firebase Admin only); admins can read/delete
    match /newsletter/{docId} {
      allow create, update: if false;
      allow read, delete: if request.auth != null && isAdmin();
    }

    // Volunteer applications: anyone can create, only admins can read/update/delete
    match /volunteerApplications/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null && isAdmin();
    }

    // Contact messages: anyone can create, only admins can read/update/delete
    match /contactMessages/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null && isAdmin();
    }

    // Volunteer positions: anyone can read, only admins can write
    match /volunteerPositions/{docId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && isAdmin();
    }

    // Volunteer testimonials (home page): anyone can read, only admins can write
    match /volunteerTestimonials/{docId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && isAdmin();
    }

    // Board of Directors: anyone can read, only admins can write
    match /boardOfDirectors/{docId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && isAdmin();
    }

    // Coming Soon Cards (Educational page): anyone can read, only admins can write
    match /comingSoonCards/{docId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && isAdmin();
    }

    // Admins: only the user can read their own document (to check if they are admin)
    match /admins/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Admin invites: server-only (Firebase Admin SDK), used for invite links
    match /adminInvites/{docId} {
      allow read, write: if false;
    }
  }
}
